#pragma once

#define QBT_VERSION_MAJOR 5
#define QBT_VERSION_MINOR 4
#define QBT_VERSION_BUGFIX 0
#define QBT_VERSION_BUILD 0
#define QBT_VERSION_STATUS "alpha1"  // Should be empty for stable releases!

#define QBT__STRINGIFY(x) #x
#define QBT_STRINGIFY(x) QBT__STRINGIFY(x)

#if (QBT_VERSION_BUILD != 0)
#define PROJECT_VERSION QBT_STRINGIFY(QBT_VERSION_MAJOR.QBT_VERSION_MINOR.QBT_VERSION_BUGFIX.QBT_VERSION_BUILD) QBT_VERSION_STATUS
#else
#define PROJECT_VERSION QBT_STRINGIFY(QBT_VERSION_MAJOR.QBT_VERSION_MINOR.QBT_VERSION_BUGFIX) QBT_VERSION_STATUS
#endif

#define QBT_VERSION "v" PROJECT_VERSION
#define QBT_VERSION_2 PROJECT_VERSION

// Name of Mankka's Edition, shown in the window title and the About dialog.
// The program still identifies itself to trackers and peers with QBT_VERSION above.
//
// Version numbering of the edition (vMAJOR.MINOR.PATCH), raised with every change:
// - MINOR + 1 (PATCH back to 0): a new feature or a visible change
// - PATCH + 1: a fix or a small tweak of an existing feature
// - MAJOR + 1 (MINOR and PATCH back to 0): moving to a newer official qBittorrent
//   release, or a big rework
// Each version is also recorded in LOCAL_CHANGES.md.
#define QBT_MOD_VERSION "v1.6.3"

// GitHub repository of the edition ("owner/name"). The program's update check looks for
// new releases here (never at the official qBittorrent), and the About dialog links to it.
#define QBT_MOD_GITHUB_REPO "mankka-beep/qBittorrent-Mankkas-Edition"
#define QBT_MOD_GITHUB_URL "https://github.com/" QBT_MOD_GITHUB_REPO
#define QBT_DISPLAY_NAME "qBittorrent " QBT_MOD_VERSION " Mankka's Edition"
#define QBT_MOD_COPYRIGHT "Modifications © 2026 Mankka"
